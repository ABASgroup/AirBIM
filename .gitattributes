# Normalise line endings to LF on commit
* text=auto eol=lf

# Shell scripts must always be LF
*.sh text eol=lf

# Python and config files
*.py text eol=lf
*.env text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Docker
Dockerfile text eol=lf
Dockerfile.* text eol=lf

# PowerShell can keep CRLF
*.ps1 text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
