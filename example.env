# Deployment & site url params
NGINX_PORT=80               # optional (for mapping)
VITE_PORT=5173              # optional (for mapping)

# FastAPI (backend url params)
API_PORT=8000               # optional (for mapping)
API_HOST=0.0.0.0            # used only for local deploy w/o script

# FastAPI security
JWT_SECRET_KEY=secretkey
JWT_EXPIRE_MINUTES=60       # optional, default is 60 minutes
JWT_ALGORITHM=HS256         # optional, default is HS256

# Database (setting + url params)
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=airbim_db
DB_HOST=localhost           # used only for local deploy w/o script
DB_PORT=5432                # optional (for mapping)